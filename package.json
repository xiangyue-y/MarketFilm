{
  "name": "ad-studio-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"npm:api\" \"npm:web\"",
    "api": "node --env-file-if-exists=.env server/index.mjs",
    "web": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js --host 127.0.0.1 --strictPort",
    "build": "vite build",
    "smoke": "node --env-file-if-exists=.env scripts/smoke.mjs",
    "test:narration": "node scripts/test-narration.mjs",
    "start": "npm run api"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "express": "^5.1.0",
    "fflate": "0.8.3",
    "ffmpeg-static": "^5.2.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sharp": "0.35.5",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "vite": "^7.1.7"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
