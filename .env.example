# Local source checkout. Copy to .env and edit; .env is ignored by Git.
API_PORT=4188
# AD_STUDIO_STORAGE=./storage

# Wan 2.2 TI2V 5B through ComfyUI. Use either a direct URL or SSH forwarding.
# Default without either setting: http://127.0.0.1:8188
# WAN_COMFY_URL=http://127.0.0.1:8188
# WAN_SSH_HOST=your-ssh-alias
# WAN_REMOTE_PORT=8188
# WAN_LOCAL_PORT=18188
# Optional: set all three absolute paths to also start ComfyUI on the remote Linux host.
# WAN_REMOTE_COMFY_DIR=/path/to/ComfyUI
# WAN_REMOTE_PYTHON=/path/to/venv/bin/python
# WAN_REMOTE_WORK_DIR=/path/to/marketfilm-data
# WAN_GPU_MIN_FREE_MIB=22000
# Only change these names when compatible checkpoints are listed under different names.
# WAN_UNET=wan2.2_ti2v_5B_fp16.safetensors
# WAN_TEXT_ENCODER=umt5_xxl_fp8_e4m3fn_scaled.safetensors
# WAN_VAE=wan2.2_vae.safetensors
# WAN_PRESET=quick

# Qwen3-VL. Use a running multimodal server (base URL includes /v1),
# or leave PLANNER_BASE_URL unset to run llama-server here.
# PLANNER_BASE_URL=http://127.0.0.1:8080/v1
# PLANNER_MODEL_ID=qwen3-vl-2b
# PLANNER_API_KEY=
# PLANNER_PORT=18189
# PLANNER_BINARY=/path/to/llama-server
# PLANNER_MODEL=/path/to/Qwen3VL-2B-Instruct-Q4_K_M.gguf
# PLANNER_MMPROJ=/path/to/mmproj-Qwen3VL-2B-Instruct-Q8_0.gguf
# PLANNER_GPU_LAYERS=0

# Optional local narration (Apple Silicon Mac only).
# TTS_PYTHON=/path/to/tts-venv/bin/python
# TTS_MODEL_PATH=/path/to/qwen3-tts
# TTS_VOICE=serena
